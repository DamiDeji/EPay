{
  "uid": "epay-queue-lag",
  "title": "EPay — Queue Lag & Indexer Progress",
  "tags": ["epay", "queue", "indexer"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "BullMQ jobs by state",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "epay_queue_waiting_jobs", "legendFormat": "{{queue}} waiting", "refId": "A" },
        { "expr": "epay_queue_active_jobs", "legendFormat": "{{queue}} active", "refId": "B" },
        { "expr": "epay_queue_delayed_jobs", "legendFormat": "{{queue}} delayed", "refId": "C" },
        { "expr": "epay_queue_failed_jobs", "legendFormat": "{{queue}} failed", "refId": "D" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Indexer lag (chain head − indexed ledger)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "epay_indexer_ledger_lag", "legendFormat": "ledgers behind", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 200 }] } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Job processing time p95 by queue",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(epay_queue_job_duration_seconds_bucket[5m])) by (le, queue))", "legendFormat": "{{queue}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Jobs failed in the last hour",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "sum(increase(epay_queue_failed_total[1h]))", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    }
  ]
}
