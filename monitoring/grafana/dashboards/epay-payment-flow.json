{
  "uid": "epay-payment-flow",
  "title": "EPay — Payment Flow Success Rate",
  "tags": ["epay", "payments", "slo"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-12h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Payment success rate (30d SLI)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(epay_payments_total{status=\"COMPLETED\"}[30d])) / clamp_min(sum(rate(epay_payments_total[30d])), 0.001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 0.99 }, { "color": "green", "value": 0.995 }] }
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payments by terminal status",
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "sum by (status) (rate(epay_payments_total[5m]))", "legendFormat": "{{status}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Payment stage duration p95 (create → confirm → settle)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(epay_payment_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Webhook delivery outcomes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "sum by (outcome) (rate(epay_webhook_deliveries_total[5m]))", "legendFormat": "{{outcome}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Refund rate (7d rolling)",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(epay_payments_total{status=\"REFUNDED\"}[7d])) / clamp_min(sum(rate(epay_payments_total[7d])), 0.001)",
          "legendFormat": "refund rate",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error budget burn (1h / 6h windows vs 99.5% SLO)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        {
          "expr": "(1 - (sum(rate(epay_payments_total{status=\"COMPLETED\"}[1h])) / clamp_min(sum(rate(epay_payments_total[1h])), 0.001))) / (1 - 0.995)",
          "legendFormat": "1h burn",
          "refId": "A"
        },
        {
          "expr": "(1 - (sum(rate(epay_payments_total{status=\"COMPLETED\"}[6h])) / clamp_min(sum(rate(epay_payments_total[6h])), 0.001))) / (1 - 0.995)",
          "legendFormat": "6h burn",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 14 }] } } }
    }
  ]
}
