{
  "uid": "epay-platform-health",
  "title": "EPay — Platform Health",
  "tags": ["epay", "platform"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "component",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
        "query": "label_values(up{job=~\"epay-.*\"}, job)",
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Services up",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [{ "expr": "sum(up{job=~\"$component\"})", "refId": "A" }],
      "fieldConfig": {
        "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API request rate by status class",
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(epay_http_requests_total{job=\"epay-api\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum(rate(epay_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(epay_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(epay_http_request_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 0 } } }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "DB connection-pool wait (p99)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(epay_db_pool_wait_seconds_bucket[5m])) by (le))", "legendFormat": "p99 pool wait", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Node CPU / memory saturation (API + indexer)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "rate(process_cpu_seconds_total{job=~\"epay-.*\"}[5m])", "legendFormat": "{{job}} cpu cores", "refId": "A" },
        { "expr": "process_resident_memory_bytes{job=~\"epay-.*\"} / 1024 / 1024", "legendFormat": "{{job}} RSS MiB", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Postgres throughput and connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "epay-prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname=\"epay\"}[5m])", "legendFormat": "commits/s", "refId": "A" },
        { "expr": "pg_stat_activity_count{datname=\"epay\"}", "legendFormat": "connections", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
