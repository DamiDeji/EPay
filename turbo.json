{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "STELLAR_NETWORK",
    "STELLAR_HORIZON_URL",
    "STELLAR_SOROBAN_RPC_URL",
    "JWT_SECRET",
    "API_URL",
    "EXPO_PUBLIC_API_URL",
    "EXPO_PUBLIC_STELLAR_NETWORK",
    "EXPO_PUBLIC_HORIZON_URL",
    "EXPO_PUBLIC_SOROBAN_RPC_URL",
    "EXPO_PUBLIC_EAS_PROJECT_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "target/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "**/*.test.*", "**/*.spec.*"]
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "inputs": ["src/**", "test/**", "**/*.test.*", "**/*.spec.*"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
