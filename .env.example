# ── EPay Environment Configuration ────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# The testnet contract addresses below are from the latest deployment.
# See DEPLOYMENTS.md for explorer links and deployment details.

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://epay:epay_dev@localhost:5432/epay_dev

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stellar Network ───────────────────────────────────────────────────────────
# Options: testnet | public | futurenet | sandbox
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-32-character-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

