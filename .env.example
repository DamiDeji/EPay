# =============================================================================
# EPay Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epay

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── TON Blockchain ───────────────────────────────────────────────────────────
TON_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
TON_NETWORK=testnet
TON_API_KEY=

# ── Smart Contract Addresses ─────────────────────────────────────────────────
PAYMENT_ROUTER_ADDRESS=
INVOICE_MANAGER_ADDRESS=
ESCROW_MANAGER_ADDRESS=
REFUND_MANAGER_ADDRESS=
SUBSCRIPTION_MANAGER_ADDRESS=
TREASURY_VAULT_ADDRESS=
MERCHANT_REGISTRY_ADDRESS=

# ── Indexer ──────────────────────────────────────────────────────────────────
INDEXER_POLL_INTERVAL_MS=10000
INDEXER_BATCH_SIZE=100
INDEXER_CONFIRMATION_BLOCKS=20
INDEXER_START_BLOCK=0
INDEXER_REALTIME_ENABLED=true
INDEXER_HISTORICAL_ENABLED=true

# ── API Server ───────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
NODE_ENV=development
LOG_LEVEL=info

# ── Web Apps ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
