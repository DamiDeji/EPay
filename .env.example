# =============================================================================
# EPay Environment Configuration — Stellar Testnet
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/epay

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Stellar Blockchain (Testnet) ─────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ── Soroban Contract IDs (fill after deployment) ─────────────────────────────
PAYMENT_ROUTER_CONTRACT_ID=
MERCHANT_REGISTRY_CONTRACT_ID=
INVOICE_MANAGER_CONTRACT_ID=
ESCROW_MANAGER_CONTRACT_ID=
SUBSCRIPTION_MANAGER_CONTRACT_ID=
REFUND_MANAGER_CONTRACT_ID=
TREASURY_VAULT_CONTRACT_ID=
FEE_MANAGER_CONTRACT_ID=
SETTLEMENT_MANAGER_CONTRACT_ID=
CONFIGURATION_MANAGER_CONTRACT_ID=
ROLE_MANAGER_CONTRACT_ID=
EMERGENCY_PAUSE_CONTRACT_ID=

# ── Indexer ──────────────────────────────────────────────────────────────────
INDEXER_POLL_INTERVAL_MS=10000
INDEXER_BATCH_SIZE=100
INDEXER_CONFIRMATION_LEDGERS=12
INDEXER_START_LEDGER=0
INDEXER_REALTIME_ENABLED=true
INDEXER_HISTORICAL_ENABLED=true

# ── API Server ───────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ── Web Apps ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STELLAR_NETWORK=testnet
