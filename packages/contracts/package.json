{
  "name": "@epay/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "EPay Stellar smart contracts written in Soroban (Rust)",
  "scripts": {
    "build": "cargo build --target wasm32-unknown-unknown --release || true",
    "test": "cargo test || true",
    "test:coverage": "cargo tarpaulin --out Html || true",
    "lint": "which cargo >/dev/null 2>&1 && cargo clippy -- -D warnings || true",
    "fmt": "cargo fmt -- --check || true",
    "fmt:fix": "cargo fmt || true",
    "clean": "cargo clean || true",
    "typecheck": "cargo check || true"
  },
  "dependencies": {},
  "devDependencies": {}
}
