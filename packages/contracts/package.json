{
  "name": "@epay/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "EPay TON smart contracts written in TACT",
  "scripts": {
    "build": "tact --config ./tact.config.json",
    "test": "tact --config ./tact.config.json && jest",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint tests/",
    "clean": "rm -rf build/ dist/"
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0"
  },
  "devDependencies": {
    "@tact-lang/compiler": "^1.6.0",
    "@tact-lang/emulator": "^4.3.0",
    "@ton/sandbox": "^0.19.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.5.0"
  }
}
