{
  "name": "@epay/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "EPay TypeScript SDK for TON payment integration",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
