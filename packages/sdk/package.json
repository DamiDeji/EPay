{
  "name": "@epay/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "EPay TypeScript SDK for Stellar payment integration",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@epay/types": "workspace:*",
    "@stellar/stellar-sdk": "^17.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "typescript": "^5.5.0",
    "vitest": "^3.2.0"
  }
}
