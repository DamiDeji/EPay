{
  "name": "@epay/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "EPay mobile app — QR payments, biometric auth, push receipts (Expo / React Native)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform ios --platform android",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ app/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fix": "expo install --fix",
    "clean": "rm -rf .expo dist"
  },
  "dependencies": {
    "@epay/sdk": "workspace:*",
    "@epay/types": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@epay/config": "workspace:*",
    "@types/react": "~19.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
