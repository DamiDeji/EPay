# ── EPay Mobile (Expo) ────────────────────────────────────────────────────────
# Only variables prefixed with EXPO_PUBLIC_ are inlined into the bundle.
# Copy to .env.local before running `pnpm --filter @epay/mobile dev`.

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_STELLAR_NETWORK=testnet
EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# EAS project id — required to mint an Expo push token for receipt notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
