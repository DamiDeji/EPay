  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/passport-jwt": "^4.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.0",
    "typescript": "^7.0.2"
  }
