{
  "name": "@epay/tests",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "load": "k6 run k6/load-tests.js",
    "load:stress": "k6 run --vus 100 --duration 3m k6/load-tests.js",
    "load:spike": "k6 run --vus 50 --duration 10s k6/load-tests.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@axe-core/playwright": "^2.0.0",
    "k6": "^0.50.0"
  }
}
