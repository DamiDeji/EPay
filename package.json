{
  "name": "epay",
  "version": "1.0.0",
  "private": true,
  "description": "EPay - Decentralized Payment Gateway on Stellar",
  "author": "EPay Contributors",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:quick": "bash scripts/ci-local.sh --quick",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "contracts:build": "pnpm --filter @epay/contracts build",
    "contracts:test": "pnpm --filter @epay/contracts test",
    "db:migrate": "pnpm --filter @epay/database migrate",
    "db:generate": "pnpm --filter @epay/database generate",
    "db:seed": "pnpm --filter @epay/database seed",
    "api:dev": "pnpm --filter @epay/api dev",
    "web:dev": "pnpm --filter @epay/web dev",
    "merchant:dev": "pnpm --filter @epay/merchant-dashboard dev",
    "admin:dev": "pnpm --filter @epay/admin-dashboard dev",
    "indexer:dev": "pnpm --filter @epay/indexer dev",
    "mobile:dev": "pnpm --filter @epay/mobile dev",
    "extension:build": "pnpm --filter @epay/extension build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.3.0",
    "turbo": "^2.10.12",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
